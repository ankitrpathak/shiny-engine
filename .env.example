# ==============================================================================
# ON DEMAND CAR WASH PLATFORM - ENVIRONMENT CONFIGURATION (LOCALHOST)
# ==============================================================================
# All services run locally on localhost.
# By default, all microservices use embedded in-memory H2 database with
# zero installation or setup required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# By default, services use zero-config in-memory H2 database (Leave commented out).
# If you want to connect your local MySQL installed on this laptop, uncomment below:
# DB_URL=jdbc:mysql://localhost:3306/carwash_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 2. RABBITMQ MESSAGE BROKER (OPTIONAL)
# ------------------------------------------------------------------------------
# If you have RabbitMQ running locally on Windows (port 5672):
# If RabbitMQ is not running, microservices safely catch the error and continue smoothly.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# 3. SERVICE DISCOVERY & SECURITY
# ------------------------------------------------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka/
JWT_SECRET=carwashsecretkey2026carwashsecretkey2026carwashsecretkey2026

# ------------------------------------------------------------------------------
# 4. RAZORPAY TEST CREDENTIALS
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_carwash2026
RAZORPAY_KEY_SECRET=test_secret_key_carwash2026
